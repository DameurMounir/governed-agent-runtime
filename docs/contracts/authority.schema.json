{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DameurMounir/governed-agent-runtime/schemas/authority.schema.json",
  "title": "Governed authority grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_id",
    "subject",
    "workflow_id",
    "capabilities",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "authorization_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "single_use": {"type": "boolean", "default": true}
  }
}
