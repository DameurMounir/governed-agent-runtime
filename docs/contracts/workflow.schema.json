{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DameurMounir/governed-agent-runtime/schemas/workflow.schema.json",
  "title": "Governed workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "correlation_id", "steps"],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "agent_id", "action", "capability"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "agent_id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "effect": {
            "type": "string",
            "enum": ["READ_ONLY", "REVERSIBLE", "IRREVERSIBLE"],
            "default": "READ_ONLY"
          },
          "requires_evidence_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1},
            "default": []
          },
          "input_data": {"type": "object", "default": {}}
        }
      }
    }
  }
}
